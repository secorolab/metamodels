{
    "@context": {
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "col": "https://secorolab.github.io/metamodels/color#",

        "Color": { "@id": "col:Color" },
        "RGB": { "@id": "col:RGB" },
        "RGBA": { "@id": "col:RGBA" },
        "HSV": { "@id": "col:HSV" },

        "has-color": { "@id": "col:has-color", "@type": "@id" },
        "value": { "@id": "col:value", "@type": "xsd:string" }
    }
}
