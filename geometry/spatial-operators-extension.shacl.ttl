@prefix geom-op:  <https://comp-rob2b.github.io/metamodels/geometry/spatial-operators#> .
@prefix geom-op-ext: <https://secorolab.github.io/metamodels/geometry/spatial-operators#> .
@prefix geom-coord: <https://comp-rob2b.github.io/metamodels/geometry/coordinates#> .
@prefix geom-path: <https://secorolab.github.io/metamodels/geometry/path#> .
@prefix cstr-hdl: <https://comp-rob2b.github.io/metamodels/task/constraint-handler#> .
@prefix qkind:    <http://qudt.org/vocab/quantitykind/> .
@prefix qudt:     <http://qudt.org/schema/qudt/> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .

geom-op:InvertPose
    a rdfs:Class, sh:NodeShape ;
    sh:targetClass geom-op:InvertPose ;
    sh:message "A pose inversion needs one pose-coordinate input and one pose-coordinate output." ;
    sh:property [
        sh:path geom-op:pose ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] ;
    sh:property [
        sh:path geom-op:out ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] .

geom-op-ext:PoseDiffEvaluator
    a rdfs:Class, sh:NodeShape ;
    sh:targetClass geom-op-ext:PoseDiffEvaluator ;
    sh:message "A pose-difference evaluator needs two pose-coordinate inputs and one pose-difference-coordinate output." ;
    sh:property [
        sh:path geom-op:in1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] ;
    sh:property [
        sh:path geom-op:in2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] ;
    sh:property [
        sh:path geom-op:out ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseDifferenceCoordinate
    ] .

geom-op-ext:PoseToAngularDistance
    a rdfs:Class, sh:NodeShape ;
    sh:targetClass geom-op-ext:PoseToAngularDistance ;
    sh:message "A pose-to-angular-distance operator needs one pose-coordinate input and one angular-distance-coordinate output." ;
    sh:property [
        sh:path geom-op:pose ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] ;
    sh:property [
        sh:path geom-op-ext:angular-distance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:AngularDistanceCoordinate
    ] .

geom-op-ext:ComposeOrientation
    a rdfs:Class, sh:NodeShape ;
    sh:targetClass geom-op-ext:ComposeOrientation ;
    sh:message "An orientation composition needs one base and one rotation, in multiplication order, and one orientation-coordinate composite." ;
    sh:property [
        sh:path geom-op:in1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI
    ] ;
    sh:property [
        sh:path geom-op:in2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI
    ] ;
    sh:property [
        sh:path geom-op:composite ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:OrientationCoordinate
    ] ;
    sh:xone (
        [
            sh:property [ sh:path geom-op:in1 ; sh:node geom-op-ext:OrientationBaseShape ] ;
            sh:property [ sh:path geom-op:in2 ; sh:node geom-op-ext:RotationShape ]
        ]
        [
            sh:property [ sh:path geom-op:in1 ; sh:node geom-op-ext:RotationShape ] ;
            sh:property [ sh:path geom-op:in2 ; sh:node geom-op-ext:OrientationBaseShape ]
        ]
    ) .

geom-op-ext:OrientationBaseShape
    a sh:NodeShape ;
    sh:message "The base of an orientation composition must be a pose or an orientation coordinate." ;
    sh:or (
        [ sh:class geom-coord:PoseCoordinate ]
        [ sh:class geom-coord:OrientationCoordinate ]
    ) .

geom-op-ext:RotationShape
    a sh:NodeShape ;
    sh:message "A rotation must be parameterised as Euler angles, a quaternion, or direction cosines." ;
    sh:or (
        [ sh:class geom-coord:EulerAngles ]
        [ sh:class geom-coord:Quaternion ]
        [ sh:class geom-coord:DirectionCosineXYZ ]
    ) .

# Following a path: the parameter is measured, not commanded, so it is the projection's
# output. Separating travel along the path from leaving it needs a local frame, which is why
# the tangent and its two normals are outputs too.
geom-op-ext:PathProjection
    a rdfs:Class, sh:NodeShape ;
    sh:targetClass geom-op-ext:PathProjection ;
    sh:message "A path projection needs one path typed geom-path:Path, the pose it projects, the twist measuring that pose, and it produces a path parameter, a tangent with two normals, a speed along the path, and the pose-coordinate output at the projection." ;
    sh:property [
        sh:path geom-op-ext:path ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-path:Path
    ] ;
    sh:property [
        sh:path geom-op:in ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] ;
    sh:property [
        sh:path cstr-hdl:measured-velocity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:VelocityTwistCoordinate
    ] ;
    sh:property [
        sh:path geom-op-ext:path-parameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node geom-op-ext:PathParameterShape
    ] ;
    sh:property [
        sh:path geom-op-ext:tangent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:DirectionCoordinate
    ] ;
    sh:property [
        sh:path geom-op-ext:normal-a ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:DirectionCoordinate
    ] ;
    sh:property [
        sh:path geom-op-ext:normal-b ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:DirectionCoordinate
    ] ;
    sh:property [
        sh:path geom-op-ext:along-speed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:Quantity ;
        sh:node [ sh:property [ sh:path qudt:hasQuantityKind ; sh:hasValue qkind:LinearVelocity ] ]
    ] ;
    sh:property [
        sh:path geom-op:out ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class geom-coord:PoseCoordinate
    ] .

geom-op-ext:PathParameterShape
    a sh:NodeShape ;
    sh:message "A path parameter must be a dimensionless quantity whose value, when it has one, lies in the interval [0, 1]." ;
    sh:class qudt:Quantity ;
    sh:property [ sh:path qudt:hasQuantityKind ; sh:hasValue qkind:Dimensionless ] ;
    sh:property [ sh:path qudt:value ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ] .
