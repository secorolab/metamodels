@prefix ex: <https://example.org/scene/> .
@prefix astro: <http://www.astro.umd.edu/~eshaya/astro-onto/owl/geometry.owl#> .
@prefix shapes: <https://secorolab.github.io/metamodels/geometry/shape-resources#> .
@prefix geom: <https://comp-rob2b.github.io/metamodels/geometry/structural-entities#> .
@prefix distrib: <https://secorolab.github.io/metamodels/probability/distribution#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:body a geom:RigidBody ;
    geom:simplices ex:prismFrame, ex:sphereFrame, ex:cylinderFrame .
ex:prismFrame a geom:Frame .
ex:sphereFrame a geom:Frame .
ex:cylinderFrame a geom:Frame .

# Each primitive's local origin is its geometric center. Its frame can be
# posed elsewhere on the body without changing the primitive's unit base.
ex:prism a astro:rectangularPrism, shapes:ScaledShape ;
    shapes:attached-to-frame ex:prismFrame ;
    shapes:has-dimension ex:prismSide ;
    shapes:scale-x "0.2"^^xsd:double ; shapes:scale-y "0.3"^^xsd:double ; shapes:scale-z "0.01"^^xsd:double .
ex:prismSide a astro:length, qudt:Quantity ;
    qudt:hasQuantityKind qkind:Distance ;
    qudt:value "1.0"^^xsd:double ; qudt:unit unit:M .

# A single fixed DSL factor (scale: 0.05) is exported on all three axes.
ex:uniformPrism a astro:rectangularPrism, shapes:ScaledShape ;
    shapes:attached-to-frame ex:prismFrame ;
    shapes:has-dimension ex:prismSide ;
    shapes:scale-x "0.05"^^xsd:double ;
    shapes:scale-y "0.05"^^xsd:double ;
    shapes:scale-z "0.05"^^xsd:double .

ex:sphere a astro:sphere, shapes:ScaledShape ;
    shapes:attached-to-frame ex:sphereFrame ;
    shapes:has-dimension ex:sphereRadius ;
    distrib:from-distribution ex:sphereScaleRange .
ex:sphereRadius a astro:radius, qudt:Quantity ;
    qudt:hasQuantityKind qkind:Distance ;
    qudt:value "0.5"^^xsd:double ; qudt:unit unit:M .
ex:sphereScaleRange a distrib:Distribution, distrib:Uniform ;
    distrib:dimension "3"^^xsd:positiveInteger ;
    distrib:lower-bound ("0.04"^^xsd:decimal "0.02"^^xsd:decimal "0.02"^^xsd:decimal) ;
    distrib:upper-bound ("0.08"^^xsd:decimal "0.04"^^xsd:decimal "0.04"^^xsd:decimal) .

ex:cylinder a shapes:Cylinder, shapes:ScaledShape ;
    shapes:attached-to-frame ex:cylinderFrame ;
    shapes:has-dimension ex:cylinderRadius, ex:cylinderHeight ;
    shapes:scale-x "0.02"^^xsd:double ; shapes:scale-y "0.03"^^xsd:double ; shapes:scale-z "0.1"^^xsd:double .
ex:cylinderRadius a astro:radius, qudt:Quantity ;
    qudt:hasQuantityKind qkind:Distance ;
    qudt:value "0.5"^^xsd:double ; qudt:unit unit:M .
ex:cylinderHeight a astro:height, qudt:Quantity ;
    qudt:hasQuantityKind qkind:Distance ;
    qudt:value "1.0"^^xsd:double ; qudt:unit unit:M .
