@prefix geom: <https://comp-rob2b.github.io/metamodels/geometry/structural-entities#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://secorolab.github.io/metamodels/geometry/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:attached-to-frame
    rdfs:range geom:Frame ;
    rdfs:comment "Links a shape to a placement frame. The shape's local origin and axes coincide with that frame's origin and axes; the frame's pose locates the shape relative to other frames. The frame need not belong to a rigid body." .

shapes:Shape a rdfs:Class ;
    rdfs:comment "Geometry on a frame, in a length unit, that is drawn, takes part in contact, or both. An instance carries this class alongside its geometric type, such as UnitCube, so that a constraint can require a shape without enumerating the types." .
shapes:UnitCube a rdfs:Class ; rdfs:subClassOf shapes:Shape ;
    rdfs:comment "Cube with local X, Y, and Z bounds from -0.5 to +0.5 in its declared length unit. The attached frame origin is its centroid." .
shapes:UnitCylinder a rdfs:Class ; rdfs:subClassOf shapes:Shape ;
    rdfs:comment "Cylinder of radius 1 and height 1 in its declared length unit along local Z, centered on the attached frame at its centroid." .
shapes:UnitSphere a rdfs:Class ; rdfs:subClassOf shapes:Shape ;
    rdfs:comment "Sphere of radius 1 in its declared length unit, centered on the attached frame at its centroid." .
shapes:FileBasedShape a rdfs:Class ; rdfs:subClassOf shapes:Shape ;
    rdfs:comment "Shape whose geometry is read from a file, such as a mesh, instead of a unit base. The file's authored origin and axes are the shape's local origin and axes." .
shapes:ScaledShape a rdfs:Class ;
    rdfs:comment "Marks a shape whose positive, dimensionless local scale is given by numeric axis factors. Equal factors give uniform scale. The geometric type identifies the unit base before scaling; scaling precedes the attached frame pose." .
shapes:scale-x rdfs:domain shapes:ScaledShape ; rdfs:range xsd:double ;
    rdfs:comment "Positive dimensionless factor along the shape's local X axis." .
shapes:scale-y rdfs:domain shapes:ScaledShape ; rdfs:range xsd:double ;
    rdfs:comment "Positive dimensionless factor along the shape's local Y axis." .
shapes:scale-z rdfs:domain shapes:ScaledShape ; rdfs:range xsd:double ;
    rdfs:comment "Positive dimensionless factor along the shape's local Z axis." .
shapes:VisualShape a rdfs:Class ;
    rdfs:comment "Marks a shape that is drawn: viewers and renderers show it. It says nothing about contact. Every shape is a VisualShape, a CollisionShape, or both." .
shapes:CollisionShape a rdfs:Class ;
    rdfs:comment "Marks a shape that takes part in contact: collision checkers and physics engines test it. A CollisionShape that is not also a VisualShape is not drawn by default; a viewer may still show it when displaying collision geometry for debugging. Every shape is a VisualShape, a CollisionShape, or both." .

shapes:ShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:Shape ;
    sh:description "Every shape hangs on one frame, has one length unit, and states what it is for: it is a VisualShape, a CollisionShape, or both." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:property shapes:LengthUnitProperty ;
    sh:or (
        [ sh:class shapes:VisualShape ]
        [ sh:class shapes:CollisionShape ]
    ) .

shapes:ShapeClassConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:UnitCube, shapes:UnitCylinder, shapes:UnitSphere, shapes:FileBasedShape ;
    sh:targetClass shapes:VisualShape, shapes:CollisionShape ;
    sh:description "A geometric type or a role marks a shape, so its node also carries Shape, which brings the frame, unit and role constraints." ;
    sh:class shapes:Shape .

shapes:AttachedFrameProperty
    a sh:PropertyShape ;
    sh:path shapes:attached-to-frame ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class geom:Frame .

shapes:LengthUnitProperty
    a sh:PropertyShape ;
    sh:description "Length unit for local geometry; consumers check supported units." ;
    sh:path qudt:unit ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:nodeKind sh:IRI .

shapes:FileBasedShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:FileBasedShape ;
    sh:description "The attached frame coincides with the file's authored origin and axes; its coordinates use the declared length unit and scale acts before the frame pose. Its node also carries prov:Entity as a second type, not a superclass, so the shape's derivation from the file can be recorded." ;
    sh:class prov:Entity .

shapes:ScaleFactorConstraint
    a sh:NodeShape ;
    sh:datatype xsd:double ;
    sh:minExclusive 0 .

shapes:ScaledShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:ScaledShape ;
    sh:property [ sh:path shapes:scale-x ; sh:minCount 1 ; sh:maxCount 1 ; sh:node shapes:ScaleFactorConstraint ] ;
    sh:property [ sh:path shapes:scale-y ; sh:minCount 1 ; sh:maxCount 1 ; sh:node shapes:ScaleFactorConstraint ] ;
    sh:property [ sh:path shapes:scale-z ; sh:minCount 1 ; sh:maxCount 1 ; sh:node shapes:ScaleFactorConstraint ] .
