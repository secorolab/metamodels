{
    "@context": {
        "shapes": "https://secorolab.github.io/metamodels/geometry/shape-resources#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",

        "attached-to-frame": { "@id": "shapes:attached-to-frame", "@type": "@id" },
        "has-dimension": { "@id": "shapes:has-dimension", "@type": "@id", "@container": "@set" },
        "Cylinder": { "@id": "shapes:Cylinder" },
        "RightCircularCone": { "@id": "shapes:RightCircularCone" },
        "Tetrahedron": { "@id": "shapes:Tetrahedron" },
        "TriangularPrism": { "@id": "shapes:TriangularPrism" },
        "FileBasedShape": { "@id": "shapes:FileBasedShape" },
        "ScaledShape": { "@id": "shapes:ScaledShape" },
        "uniform-scale": { "@id": "shapes:uniform-scale", "@type": "xsd:double" },
        "scale-x": { "@id": "shapes:scale-x", "@type": "xsd:double" },
        "scale-y": { "@id": "shapes:scale-y", "@type": "xsd:double" },
        "scale-z": { "@id": "shapes:scale-z", "@type": "xsd:double" }
    }
}
