{
    "@context": {
        "shapes": "https://secorolab.github.io/metamodels/geometry/shape-resources#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",

        "attached-to-frame": { "@id": "shapes:attached-to-frame", "@type": "@id" },
        "has-dimension": { "@id": "shapes:has-dimension", "@type": "@id" },
        "Cylinder": { "@id": "shapes:Cylinder" },
        "MeshShape": { "@id": "shapes:MeshShape" },
        "XLength": { "@id": "shapes:XLength" },
        "YLength": { "@id": "shapes:YLength" },
        "ZLength": { "@id": "shapes:ZLength" },
        "source-path": { "@id": "shapes:source-path", "@type": "xsd:string" },
        "scale-x": { "@id": "shapes:scale-x", "@type": "xsd:double" },
        "scale-y": { "@id": "shapes:scale-y", "@type": "xsd:double" },
        "scale-z": { "@id": "shapes:scale-z", "@type": "xsd:double" },
        "scale": { "@id": "shapes:scale", "@type": "@id" }
    }
}
