@prefix astro: <http://www.astro.umd.edu/~eshaya/astro-onto/owl/geometry.owl#> .
@prefix distrib: <https://secorolab.github.io/metamodels/probability/distribution#> .
@prefix geom: <https://comp-rob2b.github.io/metamodels/geometry/structural-entities#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix prov-ext: <https://secorolab.github.io/metamodels/prov#> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://secorolab.github.io/metamodels/geometry/shape-resources#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:attached-to-frame
    rdfs:domain astro:shape ;
    rdfs:range geom:Frame ;
    rdfs:comment "Links a shape to a body-owned frame. The shape's local origin and axes coincide with that frame's origin and axes; the frame's pose locates the shape relative to other frames." .

shapes:has-dimension
    rdfs:domain astro:shape ;
    rdfs:range qudt:Quantity ;
    rdfs:comment "Links a primitive to its fixed unit-base dimension, with the value and unit constrained for each shape kind." .

shapes:Cylinder a rdfs:Class ; rdfs:subClassOf astro:three-D_Shape .
shapes:RightCircularCone a rdfs:Class ; rdfs:subClassOf astro:circularCone ;
    rdfs:comment "Unit-base cone: its circular base is perpendicular to its local Z axis, with the apex directly above the base center. Independent X/Y scale can make the rendered cone elliptical." .
shapes:Tetrahedron a rdfs:Class ; rdfs:subClassOf astro:pyramid .
shapes:TriangularPrism a rdfs:Class ; rdfs:subClassOf astro:prism .
shapes:FileBasedShape a rdfs:Class ; rdfs:subClassOf astro:three-D_Shape, prov:Entity .
shapes:ScaledShape a rdfs:Class ;
    rdfs:comment "Marks a shape whose positive, dimensionless local scale is given as three axis factors or a sampled distribution. Equal axis factors give uniform scale. The geometric type identifies the unit base before scaling; scaling precedes the attached frame pose." .
shapes:scale-x rdfs:domain shapes:ScaledShape ; rdfs:range xsd:double ;
    rdfs:comment "Positive dimensionless factor along the shape's local X axis." .
shapes:scale-y rdfs:domain shapes:ScaledShape ; rdfs:range xsd:double ;
    rdfs:comment "Positive dimensionless factor along the shape's local Y axis." .
shapes:scale-z rdfs:domain shapes:ScaledShape ; rdfs:range xsd:double ;
    rdfs:comment "Positive dimensionless factor along the shape's local Z axis." .

shapes:SphereShape
    a sh:NodeShape ;
    sh:targetClass astro:sphere ;
    sh:description "The attached frame origin is the sphere's geometric center; the base radius is 0.5 metre, so scale gives full axis extents in metres." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class shapes:ScaledShape ;
    sh:property [
        sh:path shapes:has-dimension ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node shapes:SphereRadiusShape
    ] .

shapes:AttachedFrameProperty
    a sh:PropertyShape ;
    sh:path shapes:attached-to-frame ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class geom:Frame ;
    sh:node shapes:BodyOwnedFrameShape .

shapes:BodyOwnedFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:inversePath geom:simplices ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class geom:RigidBody
    ] .

shapes:SphereRadiusShape
    a sh:NodeShape ;
    sh:class astro:radius ;
    sh:node shapes:UnitRadiusShape .

shapes:PositiveDistanceShape
    a sh:NodeShape ;
    sh:class qudt:Quantity ;
    sh:property [ sh:path qudt:hasQuantityKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue qkind:Distance ] ;
    sh:property [
        sh:path qudt:value ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:double ; sh:minExclusive 0 ;
        sh:maxExclusive "INF"^^xsd:double
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( unit:M unit:CentiM unit:MilliM )
    ] .

shapes:UnitRadiusShape
    a sh:NodeShape ;
    sh:node shapes:PositiveDistanceShape ;
    sh:property [ sh:path qudt:value ; sh:hasValue "0.5"^^xsd:double ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue unit:M ] .

shapes:RectangularPrismConstraint
    a sh:NodeShape ;
    sh:targetClass astro:rectangularPrism ;
    sh:description "The attached frame origin is the prism's geometric center. Its base is one metre along each local axis before scale." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class shapes:ScaledShape ;
    sh:node shapes:UnitExtentShape .

shapes:UnitExtentShape
    a sh:NodeShape ;
    sh:property [
        sh:path shapes:has-dimension ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class astro:length ; sh:node shapes:PositiveDistanceShape ;
        sh:node [
            sh:property [ sh:path qudt:value ; sh:hasValue "1.0"^^xsd:double ] ;
            sh:property [ sh:path qudt:unit ; sh:hasValue unit:M ]
        ]
    ] .

shapes:CylinderShape
    a sh:NodeShape ;
    sh:targetClass shapes:Cylinder ;
    sh:description "The attached frame origin is the cylinder's geometric center; the base radius is 0.5 metre and height is 1 metre along local Z." ;
    sh:node shapes:UnitRadiusHeightShape .

shapes:RightCircularConeShape
    a sh:NodeShape ;
    sh:targetClass shapes:RightCircularCone ;
    sh:description "Right circular cone with unit radius 0.5 metre and height 1 metre along local Z. The frame is at the midpoint of its bounds: base Z = -0.5, apex Z = +0.5 metre." ;
    sh:node shapes:UnitRadiusHeightShape .

shapes:UnitRadiusHeightShape
    a sh:NodeShape ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class shapes:ScaledShape ;
    sh:property [
        sh:path shapes:has-dimension ; sh:minCount 2 ; sh:maxCount 2 ;
        sh:node shapes:PositiveDistanceShape
    ] ;
    sh:property [
        sh:path shapes:has-dimension ;
        sh:qualifiedValueShape [ sh:class astro:radius ; sh:node shapes:UnitRadiusShape ] ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path shapes:has-dimension ;
        sh:qualifiedValueShape [
            sh:class astro:height ;
            sh:property [ sh:path qudt:value ; sh:hasValue "1.0"^^xsd:double ] ;
            sh:property [ sh:path qudt:unit ; sh:hasValue unit:M ]
        ] ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1
    ] .

shapes:TetrahedronShape
    a sh:NodeShape ;
    sh:targetClass shapes:Tetrahedron ;
    sh:description "Regular tetrahedron with one metre bounds along each local axis. Its frame is at the midpoint of the bounds, which is also its volume centroid." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class shapes:ScaledShape ;
    sh:node shapes:UnitExtentShape .

shapes:TriangularPrismShape
    a sh:NodeShape ;
    sh:targetClass shapes:TriangularPrism ;
    sh:description "Right prism with a right-isosceles triangular base and one metre bounds along each local axis. Its frame is at the midpoint of the bounds, not its volume centroid." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class shapes:ScaledShape ;
    sh:node shapes:UnitExtentShape .

shapes:FileBasedShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:FileBasedShape ;
    sh:description "The attached frame coincides with the STL file's authored origin and axes; scale acts along file axes before that frame's pose." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class prov:Entity ;
    sh:property [
        sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class prov:Entity ;
        sh:node [
            sh:property [
                sh:path prov:atLocation ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class prov-ext:RelativeLocation ;
                sh:node [
                    sh:property [
                        sh:path prov-ext:rel-path ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:datatype xsd:anyURI ; sh:pattern "\\.stl$" ; sh:flags "i"
                    ] ;
                    sh:property [
                        sh:path prov:atLocation ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:class prov:Location ; sh:nodeKind sh:IRI
                    ]
                ]
            ]
        ]
    ] ;
    sh:or (
        [ sh:class shapes:ScaledShape ]
        [
            sh:property [ sh:path shapes:scale-x ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-y ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-z ; sh:maxCount 0 ] ;
            sh:property [ sh:path distrib:from-distribution ; sh:maxCount 0 ]
        ]
    ) ;
    sh:property [
        sh:path distrib:from-distribution ;
        sh:node [ sh:property [ sh:path distrib:dimension ; sh:hasValue "3"^^xsd:positiveInteger ] ]
    ] .

shapes:ScaledShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:ScaledShape ;
    sh:or (
        [ sh:class shapes:FileBasedShape ] [ sh:class astro:rectangularPrism ]
        [ sh:class astro:sphere ] [ sh:class shapes:Cylinder ]
        [ sh:class shapes:RightCircularCone ] [ sh:class shapes:Tetrahedron ]
        [ sh:class shapes:TriangularPrism ]
    ) ;
    sh:or (
        [
            sh:property [ sh:path distrib:from-distribution ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-x ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double ] ;
            sh:property [ sh:path shapes:scale-y ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double ] ;
            sh:property [ sh:path shapes:scale-z ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double ]
        ]
        [
            sh:property [
                sh:path distrib:from-distribution ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class distrib:Uniform ;
                sh:node [
                    sh:property [
                        sh:path distrib:dimension ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:in ( "1"^^xsd:positiveInteger "3"^^xsd:positiveInteger )
                    ] ;
                    sh:property [
                        sh:path ( distrib:lower-bound [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                        sh:minCount 1 ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double
                    ] ;
                    sh:property [
                        sh:path ( distrib:upper-bound [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                        sh:minCount 1 ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double
                    ]
                ]
            ] ;
            sh:property [ sh:path shapes:scale-x ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-y ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-z ; sh:maxCount 0 ]
        ]
    ) .
