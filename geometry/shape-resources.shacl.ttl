@prefix distrib: <https://secorolab.github.io/metamodels/probability/distribution#> .
@prefix geom: <https://comp-rob2b.github.io/metamodels/geometry/structural-entities#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix prov-ext: <https://secorolab.github.io/metamodels/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://secorolab.github.io/metamodels/geometry/shape-resources#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:attached-to-frame
    rdfs:range geom:Frame ;
    rdfs:comment "Links a shape to a placement frame. The shape's local origin and axes coincide with that frame's origin and axes; the frame's pose locates the shape relative to other frames. The frame need not belong to a rigid body." .

shapes:UnitCube a rdfs:Class ;
    rdfs:comment "One-metre cube with local X, Y, and Z bounds from -0.5 to +0.5 metre. The attached frame origin is its centroid." .
shapes:UnitCylinder a rdfs:Class ;
    rdfs:comment "Cylinder of radius 1 metre and height 1 metre along local Z, centered on the attached frame at its centroid." .
shapes:UnitSphere a rdfs:Class ;
    rdfs:comment "Sphere of radius 1 metre, centered on the attached frame at its centroid." .
shapes:FileBasedShape a rdfs:Class ; rdfs:subClassOf prov:Entity .
shapes:ScaledShape a rdfs:Class ;
    rdfs:comment "Marks a shape whose positive, dimensionless local scale is given by axis factor quantities. A shared factor gives uniform scale. The geometric type identifies the unit base before scaling; scaling precedes the attached frame pose." .
shapes:scale-x rdfs:domain shapes:ScaledShape ; rdfs:range qudt:Quantity ;
    rdfs:comment "Positive dimensionless factor along the shape's local X axis." .
shapes:scale-y rdfs:domain shapes:ScaledShape ; rdfs:range qudt:Quantity ;
    rdfs:comment "Positive dimensionless factor along the shape's local Y axis." .
shapes:scale-z rdfs:domain shapes:ScaledShape ; rdfs:range qudt:Quantity ;
    rdfs:comment "Positive dimensionless factor along the shape's local Z axis." .

shapes:CenteredPrimitiveShape
    a sh:NodeShape ;
    sh:targetClass shapes:UnitCube, shapes:UnitCylinder, shapes:UnitSphere ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class shapes:ScaledShape .

shapes:AttachedFrameProperty
    a sh:PropertyShape ;
    sh:path shapes:attached-to-frame ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class geom:Frame .

shapes:FileBasedShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:FileBasedShape ;
    sh:description "The attached frame coincides with the STL file's authored origin and axes; scale acts along file axes before that frame's pose." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:class prov:Entity ;
    sh:property [
        sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class prov:Entity ;
        sh:node [
            sh:property [
                sh:path prov:atLocation ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class prov-ext:RelativeLocation ;
                sh:node [
                    sh:property [
                        sh:path prov-ext:rel-path ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:datatype xsd:anyURI ; sh:pattern "\\.stl$" ; sh:flags "i"
                    ] ;
                    sh:property [
                        sh:path prov:atLocation ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:class prov:Location ; sh:nodeKind sh:IRI
                    ]
                ]
            ]
        ]
    ] ;
    sh:or (
        [ sh:class shapes:ScaledShape ]
        [
            sh:property [ sh:path shapes:scale-x ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-y ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-z ; sh:maxCount 0 ] ;
            sh:property [ sh:path distrib:from-distribution ; sh:maxCount 0 ]
        ]
    ) .

shapes:ScaleFactorConstraint
    a sh:NodeShape ;
    sh:class qudt:Quantity ;
    sh:property [ sh:path qudt:hasQuantityKind ; sh:hasValue qkind:Dimensionless ] ;
    sh:or (
        [
            sh:not [ sh:class distrib:SampledQuantity ] ;
            sh:property [ sh:path distrib:from-distribution ; sh:maxCount 0 ] ;
            sh:property [ sh:path qudt:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double ]
        ]
        [
            sh:class distrib:SampledQuantity ;
            sh:property [ sh:path qudt:value ; sh:maxCount 0 ] ;
            sh:property [
                sh:path distrib:from-distribution ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class distrib:Distribution, distrib:Uniform ;
                sh:node [
                    sh:property [ sh:path distrib:dimension ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "1"^^xsd:positiveInteger ] ;
                    sh:property [ sh:path ( distrib:lower-bound [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double ] ;
                    sh:property [ sh:path ( distrib:upper-bound [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ; sh:maxExclusive "INF"^^xsd:double ]
                ]
            ]
        ]
    ) .

shapes:ScaledShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:ScaledShape ;
    sh:or (
        [ sh:class shapes:FileBasedShape ] [ sh:class shapes:UnitCube ]
        [ sh:class shapes:UnitCylinder ] [ sh:class shapes:UnitSphere ]
    ) ;
    sh:property [ sh:path distrib:from-distribution ; sh:maxCount 0 ] ;
    sh:property [ sh:path shapes:scale-x ; sh:minCount 1 ; sh:maxCount 1 ; sh:node shapes:ScaleFactorConstraint ] ;
    sh:property [ sh:path shapes:scale-y ; sh:minCount 1 ; sh:maxCount 1 ; sh:node shapes:ScaleFactorConstraint ] ;
    sh:property [ sh:path shapes:scale-z ; sh:minCount 1 ; sh:maxCount 1 ; sh:node shapes:ScaleFactorConstraint ] .
