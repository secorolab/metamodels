@prefix astro: <http://www.astro.umd.edu/~eshaya/astro-onto/owl/geometry.owl#> .
@prefix distrib: <https://secorolab.github.io/metamodels/probability/distribution#> .
@prefix geom: <https://comp-rob2b.github.io/metamodels/geometry/structural-entities#> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://secorolab.github.io/metamodels/geometry/shape-resources#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shapes:SphereShape
    a sh:NodeShape ;
    sh:targetClass astro:sphere ;
    sh:description "The attached frame is the sphere's local coordinate system. Its origin is the sphere center; orientation does not change the sphere." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:property [
        sh:path shapes:has-dimension ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node shapes:SphereRadiusShape
    ] .

shapes:AttachedFrameProperty
    a sh:PropertyShape ;
    sh:path shapes:attached-to-frame ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:class geom:Frame ;
    sh:node shapes:BodyOwnedFrameShape .

shapes:BodyOwnedFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:inversePath geom:simplices ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class geom:RigidBody
    ] .

shapes:SphereRadiusShape
    a sh:NodeShape ;
    sh:class astro:radius ;
    sh:node shapes:PositiveDistanceShape .

shapes:PositiveDistanceShape
    a sh:NodeShape ;
    sh:class qudt:Quantity ;
    sh:property [ sh:path qudt:hasQuantityKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue qkind:Distance ] ;
    sh:or (
        [ sh:property [
            sh:path qudt:value ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:datatype xsd:double ; sh:minExclusive 0 ;
            sh:maxExclusive "INF"^^xsd:double
        ] ]
        [ sh:node shapes:PositiveSampleShape ]
    ) ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( unit:M unit:CentiM unit:MilliM )
    ] .

shapes:PositiveSampleShape
    a sh:NodeShape ;
    sh:class distrib:SampledQuantity ;
    sh:property [ sh:path qudt:value ; sh:maxCount 0 ] ;
    sh:property [
        sh:path distrib:from-distribution ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class distrib:Uniform
    ] .

shapes:ThreeComponentSampleShape
    a sh:NodeShape ;
    sh:node shapes:PositiveSampleShape ;
    sh:property [
        sh:path distrib:from-distribution ;
        sh:node [ sh:property [
            sh:path distrib:dimension ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:hasValue "3"^^xsd:positiveInteger
        ] ]
    ] .

shapes:CubeConstraint
    a sh:NodeShape ;
    sh:targetClass astro:cube ;
    sh:description "The attached frame is at the cube center; its side is the full length along each local axis." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:node shapes:CubeDimensionsShape .

shapes:CubeDimensionsShape
    a sh:NodeShape ;
    sh:property [
        sh:path shapes:has-dimension ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class astro:length ; sh:node shapes:PositiveDistanceShape
    ] .

shapes:SingleAxisLengthShape
    a sh:NodeShape ;
    sh:xone (
        [ sh:class shapes:XLength ]
        [ sh:class shapes:YLength ]
        [ sh:class shapes:ZLength ]
    ) .

shapes:RectangularPrismConstraint
    a sh:NodeShape ;
    sh:targetClass astro:rectangularPrism ;
    sh:description "The attached frame is at the rectangular prism center; X, Y, and Z lengths are full side lengths along its axes." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:or (
        [
            sh:property [
                sh:path shapes:has-dimension ; sh:minCount 3 ; sh:maxCount 3 ;
                sh:node shapes:PositiveDistanceShape ;
                sh:node shapes:SingleAxisLengthShape
            ] ;
            sh:property [ sh:path shapes:has-dimension ; sh:qualifiedValueShape [ sh:class shapes:XLength ] ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ] ;
            sh:property [ sh:path shapes:has-dimension ; sh:qualifiedValueShape [ sh:class shapes:YLength ] ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ] ;
            sh:property [ sh:path shapes:has-dimension ; sh:qualifiedValueShape [ sh:class shapes:ZLength ] ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ]
        ]
        [
            sh:property [
                sh:path shapes:has-dimension ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:node shapes:PositiveDistanceShape ; sh:node shapes:ThreeComponentSampleShape ; sh:class shapes:DimensionsXYZ
            ]
        ]
        [ sh:class astro:cube ; sh:node shapes:CubeDimensionsShape ]
    ) .

shapes:CylinderShape
    a sh:NodeShape ;
    sh:targetClass shapes:Cylinder ;
    sh:description "The attached frame is at the cylinder center; height runs along its Z axis." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:property [
        sh:path shapes:has-dimension ; sh:minCount 2 ; sh:maxCount 2 ;
        sh:node shapes:PositiveDistanceShape
    ] ;
    sh:property [
        sh:path shapes:has-dimension ;
        sh:qualifiedValueShape [ sh:class astro:radius ] ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1
    ] ;
    sh:property [
        sh:path shapes:has-dimension ;
        sh:qualifiedValueShape [ sh:class astro:height ] ;
        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1
    ] .

shapes:MeshShapeConstraint
    a sh:NodeShape ;
    sh:targetClass shapes:MeshShape ;
    sh:description "The attached frame coincides with the STL file's authored origin and axes; scale acts along file axes before that frame's pose." ;
    sh:property shapes:AttachedFrameProperty ;
    sh:property [
        sh:path shapes:source-path ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:pattern "\\.stl$" ; sh:flags "i"
    ] ;
    sh:property [
        sh:path shapes:file-format ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue "stl"
    ] ;
    sh:or (
        [
            sh:property [ sh:path shapes:scale-x ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-y ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-z ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale ; sh:maxCount 0 ]
        ]
        [
            sh:property [ sh:path shapes:scale-x ; sh:minCount 1 ] ;
            sh:property [ sh:path shapes:scale-y ; sh:minCount 1 ] ;
            sh:property [ sh:path shapes:scale-z ; sh:minCount 1 ] ;
            sh:property [ sh:path shapes:scale ; sh:maxCount 0 ]
        ]
        [
            sh:property [ sh:path shapes:scale-x ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-y ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale-z ; sh:maxCount 0 ] ;
            sh:property [ sh:path shapes:scale ; sh:minCount 1 ; sh:maxCount 1 ; sh:class shapes:ScaleXYZ ; sh:node shapes:ThreeComponentSampleShape ]
        ]
    ) ;
    sh:property [ sh:path shapes:scale-x ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] ;
    sh:property [ sh:path shapes:scale-y ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] ;
    sh:property [ sh:path shapes:scale-z ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] .
