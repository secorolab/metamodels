@prefix ms-prov: <https://secorolab.github.io/metamodels/motion-spec/prov#> .
@prefix obs: <https://secorolab.github.io/metamodels/observation#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ms-prov:SpecCompilation
    a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "spec compilation" .

ms-prov:TaskExecution
    a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "task execution" .

ms-prov:MotionExecution
    a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "motion execution" .

ms-prov:ConstraintMaintenance
    a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "constraint maintenance" .

obs:ObservationProvider
    rdfs:subClassOf prov:SoftwareAgent .

ms-prov:ActivityShape
    a sh:NodeShape ;
    sh:message "A recorded activity names the one design element it acted on, and the agent that ran it." ;
    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] .

ms-prov:TimePositionShape
    a sh:NodeShape ;
    sh:message "A time position is a non-negative count on one stated time reference system." ;
    sh:property [
        sh:path time:numericPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path time:hasTRS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .

ms-prov:InstantShape
    a sh:NodeShape ;
    sh:targetObjectsOf time:hasBeginning ;
    sh:targetObjectsOf time:hasEnd ;
    sh:targetObjectsOf time:hasTime ;
    sh:targetObjectsOf sosa:resultTime ;
    sh:message "An interval endpoint, an occurrence anchor and a result time are instants positioned on the run's tick scale." ;
    sh:class time:Instant ;
    sh:property [
        sh:path time:inTimePosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ms-prov:TimePositionShape
    ] .

ms-prov:IntervalShape
    a sh:NodeShape ;
    sh:message "An occurrence that lasted is bounded by one beginning and one end, and anchors at no separate instant." ;
    sh:property [
        sh:path time:hasBeginning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path time:hasEnd ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path time:hasTime ;
        sh:maxCount 0
    ] .

ms-prov:InstantOccurrenceShape
    a sh:NodeShape ;
    sh:targetSubjectsOf time:hasTime ;
    sh:message "An occurrence that happened at one instant names that instant and spans no interval." ;
    sh:node ms-prov:ActivityShape ;
    sh:property [
        sh:path time:hasTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path time:hasBeginning ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path time:hasEnd ;
        sh:maxCount 0
    ] .

ms-prov:NumericValueShape
    a sh:PropertyShape ;
    sh:path sosa:hasResult ;
    sh:maxCount 1 ;
    sh:node [
        a sh:NodeShape ;
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:value ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ sh:datatype xsd:decimal ]
                [ sh:datatype xsd:double ]
            )
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI
        ]
    ] .

ms-prov:SpecCompilationShape
    a sh:NodeShape ;
    sh:targetClass ms-prov:SpecCompilation ;
    sh:message "A spec compilation reads one authored specification and is run by a toolchain agent." ;
    sh:node ms-prov:ActivityShape .

ms-prov:TaskExecutionShape
    a sh:NodeShape ;
    sh:targetClass ms-prov:TaskExecution ;
    sh:message "A task execution is the run itself: one interval on the run's tick scale, one model it executed, one agent that ran it." ;
    sh:node ms-prov:ActivityShape, ms-prov:IntervalShape .

ms-prov:MotionExecutionShape
    a sh:NodeShape ;
    sh:targetClass ms-prov:MotionExecution ;
    sh:message "A motion execution is the interval one motion was in force for, within the run that informed it." ;
    sh:node ms-prov:ActivityShape, ms-prov:IntervalShape ;
    sh:property [
        sh:path prov:wasInformedBy ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] .

ms-prov:ConstraintMaintenanceShape
    a sh:NodeShape ;
    sh:targetClass ms-prov:ConstraintMaintenance ;
    sh:message "A constraint maintenance is one interval a commanded constraint was held for, within the motion that informed it; its observed value must be numeric." ;
    sh:node ms-prov:ActivityShape, ms-prov:IntervalShape ;
    sh:property [
        sh:path prov:wasInformedBy ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property ms-prov:NumericValueShape .
