# SPDX-License-Identifier: MPL-2.0
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix prov-ext: <https://secorolab.github.io/metamodels/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

prov-ext:Transformation
  a rdfs:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "transformation" ;
  rdfs:comment "A software package turns source entities into target entities, model-to-model or model-to-code." .

prov-ext:Generalization
  a rdfs:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "generalization" ;
  rdfs:comment "Instances are drawn from a sampled quantity, e.g. poses sampled from a distribution." .

prov-ext:Execution
  a rdfs:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "execution" ;
  rdfs:comment "An agent runs a model; its logs are entities generated by this activity." .

prov-ext:Assurance
  a rdfs:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "assurance" ;
  rdfs:comment "Observations are evaluated to a verdict." .

# Shared by every prov-ext activity: what it used and who ran it. Times are
# left to prov:ActivityShape, since an activity may still be running.
prov-ext:RecordedActivityShape
  a sh:NodeShape ;
  sh:property [
    sh:path prov:used ;
    sh:minCount 1 ;
    sh:class prov:Entity ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path prov:wasAssociatedWith ;
    sh:minCount 1 ;
    sh:class prov:Agent ;
    sh:nodeKind sh:IRI
  ] .

prov-ext:GeneratingActivityShape
  a sh:NodeShape ;
  sh:property [
    sh:path [ sh:inversePath prov:wasGeneratedBy ] ;
    sh:minCount 1 ;
    sh:class prov:Entity ;
    sh:nodeKind sh:IRI
  ] .

prov-ext:TransformationShape
  a sh:NodeShape ;
  sh:targetClass prov-ext:Transformation ;
  sh:message "A transformation uses at least one source entity, generates at least one target entity, and is run by a software package." ;
  sh:node prov-ext:RecordedActivityShape, prov-ext:GeneratingActivityShape ;
  sh:property [
    sh:path prov:wasAssociatedWith ;
    sh:class prov:SoftwareAgent
  ] .

prov-ext:GeneralizationShape
  a sh:NodeShape ;
  sh:targetClass prov-ext:Generalization ;
  sh:message "A generalization uses the quantity it samples and generates at least one sampled entity." ;
  sh:node prov-ext:RecordedActivityShape, prov-ext:GeneratingActivityShape .

prov-ext:ExecutionShape
  a sh:NodeShape ;
  sh:targetClass prov-ext:Execution ;
  sh:message "An execution uses the model it ran and names the agent that ran it." ;
  sh:node prov-ext:RecordedActivityShape .

prov-ext:AssuranceShape
  a sh:NodeShape ;
  sh:targetClass prov-ext:Assurance ;
  sh:message "An assurance uses the observations it evaluated and generates a verdict." ;
  sh:node prov-ext:RecordedActivityShape, prov-ext:GeneratingActivityShape .

# A software package is a software agent with a name, and at most one version,
# source repository and revision identifier.
prov-ext:SoftwarePackageShape
  a sh:NodeShape ;
  sh:targetClass prov:SoftwareAgent ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path schema:softwareVersion ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] ;
  sh:property [
    sh:path schema:codeRepository ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path schema:identifier ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] .

prov-ext:FormatShape
  a sh:NodeShape ;
  sh:targetSubjectsOf dcterms:format ;
  sh:property [
    sh:path dcterms:format ;
    sh:maxCount 1 ;
    sh:datatype xsd:string
  ] .
