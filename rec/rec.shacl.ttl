@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ms-prov: <https://secorolab.github.io/metamodels/motion-spec/prov#> .
@prefix rec: <https://secorolab.github.io/metamodels/rec#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rec:QueuedRun a rdfs:Class ; rdfs:subClassOf ms-prov:TaskExecution .
rec:RunningRun a rdfs:Class ; rdfs:subClassOf ms-prov:TaskExecution .
rec:CompletedRun a rdfs:Class ; rdfs:subClassOf ms-prov:TaskExecution .
rec:FailedRun a rdfs:Class ; rdfs:subClassOf ms-prov:TaskExecution .
rec:InterruptedRun a rdfs:Class ; rdfs:subClassOf ms-prov:TaskExecution .
rec:CancelledRun a rdfs:Class ; rdfs:subClassOf ms-prov:TaskExecution .
rec:Metric a rdfs:Class ; rdfs:subClassOf qudt:Quantity .
rec:PathLocation a rdfs:Class ; rdfs:subClassOf prov:Location .
rec:Host a rdfs:Class ; rdfs:subClassOf prov:Location .
rec:Repository a rdfs:Class ; rdfs:subClassOf prov:Entity .
rec:Dependency a rdfs:Class ; rdfs:subClassOf prov:Entity .

rec:RunExecutionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rec:run-id ;
    sh:class prov:Activity ;
    sh:property [
        sh:path rec:run-id ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:xone (
        [ sh:class rec:QueuedRun ]
        [ sh:class rec:RunningRun ]
        [ sh:class rec:CompletedRun ]
        [ sh:class rec:FailedRun ]
        [ sh:class rec:InterruptedRun ]
        [ sh:class rec:CancelledRun ]
    ) ;
    sh:property [
        sh:path prov:atLocation ;
        sh:maxCount 1 ;
        sh:class rec:PathLocation ;
    ] ;
    # A queued run has not started, and a cancelled one was stopped before it
    # could, so neither carries a start time.
    sh:property [
        sh:path prov:startedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:or (
        [ sh:class rec:QueuedRun ]
        [ sh:class rec:CancelledRun ]
        [ sh:property [ sh:path prov:startedAtTime ; sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path prov:endedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    # Queueing and heartbeats are qualified influences carrying prov:atTime.
    sh:property [
        sh:path prov:qualifiedInfluence ;
        sh:class prov:Influence ;
    ] ;
    # Stacktrace of the exception that ended a failed or interrupted run.
    sh:property [
        sh:path rec:fail-trace ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:repositories ;
        sh:class rec:Repository ;
    ] ;
    sh:property [
        sh:path rec:dependencies ;
        sh:class rec:Dependency ;
    ] ;
    sh:property [
        sh:path rec:host-info ;
        sh:class rec:Host ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rec:metrics ;
        sh:class rec:Metric ;
    ] .

# Queue and heartbeat times: the influence itself says only when it happened.
rec:RunInfluenceShape
    a sh:NodeShape ;
    sh:targetObjectsOf prov:qualifiedInfluence ;
    sh:class prov:Influence ;
    sh:property [
        sh:path prov:atTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] .

# An input entity is consumed by the activity that used it, not by the run that
# contains that activity. Software provenance of the input lives in
# rec:repositories / rec:dependencies.
rec:ResourceUsageShape
    a sh:NodeShape ;
    sh:targetSubjectsOf prov:qualifiedUsage ;
    sh:class prov:Activity ;
    sh:property [
        sh:path prov:used ;
        sh:minCount 1 ;
        sh:class prov:Entity ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path prov:qualifiedUsage ;
        sh:class prov:Usage ;
    ] .

# An output entity the run produced, linked to its generating activity by a
# qualified generation, and pinned by hash and size.
rec:ArtefactShape
    a sh:NodeShape ;
    sh:targetSubjectsOf prov:qualifiedGeneration ;
    sh:class prov:Entity ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Activity ;
    ] ;
    sh:property [
        sh:path prov:qualifiedGeneration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class prov:Generation ;
    ] ;
    sh:property [
        sh:path rec:sha256 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:size-bytes ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
    ] .

# Dependency version is a literal pin (dcat:version), not baked into the label.
rec:DependencyShape
    a sh:NodeShape ;
    sh:targetClass rec:Dependency ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dcat:version ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

# A checked-out repository the run was produced from: where to fetch it and
# which revision. rec records no hash or size for one.
rec:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass rec:Repository ;
    sh:property [
        sh:path rdfs:label ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path dcat:accessURL ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path dcterms:hasVersion ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

# prov:atLocation must be an IRI, so the path rides as a literal on the node.
rec:PathLocationShape
    a sh:NodeShape ;
    sh:targetClass rec:PathLocation ;
    sh:property [
        sh:path rec:path ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

rec:MetricShape
    a sh:NodeShape ;
    sh:targetClass rec:Metric ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path qudt:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
        ) ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path rec:step ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;
    # Metric name, since the IRI mangles characters that are illegal in a path.
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] .

rec:HostShape
    a sh:NodeShape ;
    sh:targetClass rec:Host ;
    sh:property [
        sh:path rec:hostname ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:os ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:runtime ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path rec:cpu ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

# A source-code input, marked out from the other consumed inputs
# (config, data), which stay plain prov:Entity.
rec:SourceFileShape
    a sh:NodeShape ;
    sh:targetClass rec:SourceFile ;
    sh:class prov:Entity .
