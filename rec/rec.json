{
    "@context": {
        "@version": 1.1,
        "rec": "https://secorolab.github.io/metamodels/rec#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "dcat": "http://www.w3.org/ns/dcat#",
        "dcterms": "http://purl.org/dc/terms/",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "Repository": "rec:Repository",
        "Dependency": "rec:Dependency",
        "Host": "rec:Host",
        "Metric": "rec:Metric",
        "SourceFile": "rec:SourceFile",
        "PathLocation": "rec:PathLocation",
        "path": "rec:path",
        "sha256": "rec:sha256",
        "size_bytes": {
            "@id": "rec:size-bytes",
            "@type": "xsd:integer"
        },
        "QueuedRun": "rec:QueuedRun",
        "RunningRun": "rec:RunningRun",
        "CompletedRun": "rec:CompletedRun",
        "FailedRun": "rec:FailedRun",
        "InterruptedRun": "rec:InterruptedRun",
        "CancelledRun": "rec:CancelledRun",
        "run_id": "rec:run-id",
        "label": "rdfs:label",
        "version": "dcat:version",
        "access_url": {
            "@id": "dcat:accessURL",
            "@type": "@id"
        },
        "has_version": "dcterms:hasVersion",
        "repositories": {
            "@id": "rec:repositories",
            "@container": "@set"
        },
        "dependencies": {
            "@id": "rec:dependencies",
            "@container": "@set"
        },
        "host_info": "rec:host-info",
        "hostname": "rec:hostname",
        "os": "rec:os",
        "runtime": "rec:runtime",
        "cpu": "rec:cpu",
        "metrics": {
            "@id": "rec:metrics",
            "@container": "@set"
        },
        "step": {
            "@id": "rec:step",
            "@type": "xsd:integer"
        },
        "fail_trace": "rec:fail-trace",
        "result": "rec:result"
    }
}
