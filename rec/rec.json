{
    "@context": {
        "@version": 1.1,
        "rec": "https://secorolab.github.io/metamodels/rec#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "dcat": "http://www.w3.org/ns/dcat#",
        "oslc_auto": "http://open-services.net/ns/auto#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "schema": "https://schema.org/",
        "spdx": "http://spdx.org/rdf/terms#",
        "Host": "rec:Host",
        "Metric": "rec:Metric",
        "Checksum": "spdx:Checksum",
        "checksum": "spdx:checksum",
        "algorithm": {
            "@id": "spdx:algorithm",
            "@type": "@vocab"
        },
        "sha256": "spdx:checksumAlgorithm_sha256",
        "checksum-value": {
            "@id": "spdx:checksumValue",
            "@type": "xsd:hexBinary"
        },
        "byte-size": {
            "@id": "dcat:byteSize",
            "@type": "xsd:nonNegativeInteger"
        },
        "state": {
            "@id": "oslc_auto:state",
            "@type": "@vocab"
        },
        "new": "oslc_auto:new",
        "queued": "oslc_auto:queued",
        "in-progress": "oslc_auto:inProgress",
        "canceling": "oslc_auto:canceling",
        "canceled": "oslc_auto:canceled",
        "complete": "oslc_auto:complete",
        "verdict": {
            "@id": "oslc_auto:verdict",
            "@type": "@vocab"
        },
        "unavailable": "oslc_auto:unavailable",
        "passed": "oslc_auto:passed",
        "warning": "oslc_auto:warning",
        "failed": "oslc_auto:failed",
        "error": "oslc_auto:error",
        "label": "rdfs:label",
        "identifier": "schema:identifier",
        "os": "rec:os",
        "runtime": "rec:runtime",
        "cpu": "rec:cpu",
        "step": {
            "@id": "rec:step",
            "@type": "xsd:integer"
        },
        "heartbeat-time": {
            "@id": "rec:heartbeat-time",
            "@type": "xsd:dateTime"
        },
        "queued-time": {
            "@id": "rec:queued-time",
            "@type": "xsd:dateTime"
        },
        "fail-trace": "rec:fail-trace",
        "result": "rec:result"
    }
}
